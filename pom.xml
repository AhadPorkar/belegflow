<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.1</version><relativePath/></parent>
  <groupId>com.belegflow</groupId><artifactId>belegflow-parent</artifactId><version>0.2.1</version><packaging>pom</packaging>
  <name>BelegFlow</name><description>Evidence-first invoice approvals for multi-team businesses.</description>
  <properties><java.version>25</java.version><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <modules><module>domain</module><module>server</module></modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.15</version>
        <executions>
          <execution><id>coverage-agent</id><goals><goal>prepare-agent</goal></goals></execution>
          <execution><id>coverage-report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>release-quality</id>
      <build><plugins><plugin>
        <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId>
        <executions><execution><id>coverage-gate</id><phase>verify</phase><goals><goal>check</goal></goals>
          <configuration><rules><rule><element>BUNDLE</element><limits>
            <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
            <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.70</minimum></limit>
          </limits></rule></rules></configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>


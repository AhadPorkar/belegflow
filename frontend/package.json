{
  "name": "belegflow-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:core && npm run test:components",
    "test:e2e": "playwright test",
    "test:core": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:components": "vitest run --project components",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "test:vitest": "vitest run"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "@playwright/test": "1.64.1",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.1",
    "jsdom": "30.1.3"
  }
}
